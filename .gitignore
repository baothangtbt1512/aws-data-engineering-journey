# Virtual Environment
venv/
.venv/
env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Data files & cache (Avoid pushing raw datasets)
data/
*.parquet
*.csv
*.csv.gz

# Environment & Secrets (NEVER push credentials!)
.env
.env.*
*.pem
*.key
credentials
secrets.json

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Docker / Postgres volumes (local bind mounts if any)
pgdata/
pgadmin-data/

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
